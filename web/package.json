{
  "name": "@zju-game/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src/**/*.{ts,tsx,css} *.ts *.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:assets": "node scripts/copy-assets.mjs",
    "predev": "pnpm copy:assets",
    "prebuild": "pnpm copy:assets"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.22.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
